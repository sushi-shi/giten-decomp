+        for padding in [0, 1, 5, 15] {
+            let (section, symbol) = byte_switch(3, &[0, 1, 2], padding);
+            assert_eq!(arch.infer_function_size(&symbol, 0, &section, section.size).unwrap(), 36);
+        }
+        let (mut section, mut symbol) = byte_switch(3, &[0, 1, 2], 5);
