+    fn byte_switch(entries: usize, indices: &[u8], padding: usize) -> (Section, Symbol) {
+        // cmp ecx,bound; ja default; xor edx,edx; mov dl,[ecx+indices];
+        // jmp [edx*4+destinations]; default: ret; destinations; indices.
+        let mut code = alloc::vec![
+            0x83,
