+        symbol: &Symbol,
+        symbol_index: usize,
+        section: &Section,
+        code: &[u8],
+        instructions: &[Instruction],
+        table_address: u64,
+    ) -> Option<u64> {
+        use iced_x86::Mnemonic;
+        if !matches!(self.arch, Architecture::X86) {
+            return None;
+        }
+        let dir32 = |address| {
+            section.relocations.iter().find(|r| {
+                r.address == address && r.flags == RelocationFlags::Coff(pe::IMAGE_REL_I386_DIR32)
+            })
+        };
+        for dispatch in instructions.windows(5) {
+            let [cmp, above, zero, load, jump] = dispatch else { unreachable!() };
+            if cmp.mnemonic() != Mnemonic::Cmp
+                || cmp.op0_kind() != OpKind::Register
+                || above.mnemonic() != Mnemonic::Ja
+                || above.near_branch_target() < symbol.address
+                || above.near_branch_target() >= table_address
+                || zero.mnemonic() != Mnemonic::Xor
+                || zero.op0_kind() != OpKind::Register
+                || zero.op1_kind() != OpKind::Register
+                || zero.op0_register() != zero.op1_register()
+                || load.mnemonic() != Mnemonic::Mov
+                || load.op0_kind() != OpKind::Register
+                || load.op1_kind() != OpKind::Memory
+                || !((load.memory_base() == cmp.op0_register()
+                    && load.memory_index() == Register::None)
+                    || (load.memory_base() == Register::None
+                        && load.memory_index() == cmp.op0_register()
+                        && load.memory_index_scale() == 1))
+                || jump.mnemonic() != Mnemonic::Jmp
+                || jump.op0_kind() != OpKind::Memory
+                || jump.memory_base() != Register::None
+                || jump.memory_index() != zero.op0_register()
+                || jump.memory_index_scale() != 4
